# SheetDiff configuration — copy to .env and fill in.
# Run `npm run setup` to generate a .env with a random APP_SECRET automatically.

# Encrypts Google tokens at rest. REQUIRED. Never share or commit.
# Generate: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Google OAuth — see README "Google setup" for the 10-minute walkthrough.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match an "Authorized redirect URI" of your Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Base URL used in digest email links (defaults to http://localhost:3000).
# APP_URL=https://sheets.example.com

# --- Optional: daily digest email (SMTP) -------------------------------
# e.g. Gmail: host smtp.gmail.com, port 587, user = your address,
# pass = an App Password (https://myaccount.google.com/apppasswords).
# The digest stays off until SMTP is configured AND an address is set
# in the app's account menu.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# DIGEST_FROM=SheetDiff <you@gmail.com>

# --- Optional: demo login ----------------------------------------------
# Set to 1 ONLY for local demos: enables /auth/demo sign-in to the seeded
# demo user (npm run seed-demo). Leave unset for real deployments.
# ENABLE_DEMO=1

# --- Optional: data maintenance -----------------------------------------
# Keep the newest N non-baseline snapshots per tab (baselines always kept).
# Default 200; set 0 to keep everything forever.
# SHEETDIFF_KEEP_SNAPSHOTS=200
# Nightly SQLite backup count to keep in data/backups (default 14; 0 = off).
# SHEETDIFF_BACKUPS=14

# Optional: dead-man switch — scheduler pings this URL every minute; a free
# healthchecks.io monitor alerts you if snapshots ever silently stop.
# HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid

# Optional: SQLite database path (default ./data/sheetdiff.db)
# DATABASE_PATH=./data/sheetdiff.db

# Push notifications (ntfy): LOG_LEVEL sets log verbosity (debug|info|warn|error).
# LOG_LEVEL=info

# Allow push-notification URLs that are plain http or point at PRIVATE/LAN
# addresses (the SSRF guard refuses both by default). Set to 1 only if you
# run ntfy on the same LAN and trust every account that can sign in.
# NOTIFY_ALLOW_PRIVATE_URLS=0
